rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email in ["victorpedrorb6@gmail.com", "pedroxygaming@gmail.com", "pedrohribeiro35@gmail.com"] && 
         request.auth.token.email_verified == true)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if true;
      
      // Allow creation if it's a student OR a verified admin from the whitelist
      allow create: if isValidId(userId) && (
        request.resource.data.role == 'student' || 
        (request.resource.data.role == 'admin' && request.resource.data.email in ["victorpedrorb6@gmail.com", "pedroxygaming@gmail.com", "pedrohribeiro35@gmail.com"])
      );
      
      // Allow updates if it's the owner/admin (requires Firebase Auth)
      // OR allow the Supabase sync bridge for students
      // OR allow the Supabase sync bridge for whitelisted admins
      allow update: if (isAdmin() || isOwner(userId)) || 
                     (resource.data.role == 'student' && request.resource.data.role == 'student') ||
                     (resource.data.role == 'admin' && resource.data.email in ["victorpedrorb6@gmail.com", "pedroxygaming@gmail.com", "pedrohribeiro35@gmail.com"] && request.resource.data.email == resource.data.email);
    }

    match /schedules/{institutionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /user_progress/{userId}/institutions/{institutionId} {
      // Students can read their own progress, admins can read everything
      allow read: if isAuthenticated() && (isAdmin() || isOwner(userId));
      
      // Only Admins can unlock weeks for students (as per business logic in Schedule.tsx)
      allow write: if isAdmin();
    }
  }
}
